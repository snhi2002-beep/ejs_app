<%- include('partials/header') %>

<section class="hero">
  <h1><%= message %></h1>
  <p class="subtitle">Welcome to your new Express.js application with EJS templating!</p>
</section>

<section class="card-grid">
  <div class="card">
    <h3>✨ EJS Templating</h3>
    <p>Using reusable partials, layouts, and dynamic server-side rendering.</p>
  </div>
  <div class="card">
    <h3>🚀 Express 5 Ready</h3>
    <p>Robust routing, static middleware, and clean modular structure.</p>
  </div>
  <div class="card">
    <h3>🎨 Modern Styling</h3>
    <p>Clean responsive styling and static file serving configured out of the box.</p>
  </div>
</section>

<% if (posts && posts.length > 0) { %>
  <section class="posts-section">
    <h2>Sample Dynamic Data</h2>
    <div class="posts-list">
      <% posts.forEach(post => { %>
        <article class="post-item">
          <h4><%= post.title %></h4>
          <p><%= post.summary %></p>
        </article>
      <% }); %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
